# ========================================================
# Campus Sensor Monitoring & Alerts - Environment Configuration
# ========================================================

# Server Configuration
SERVER_PORT=8081
SERVER_HOST=0.0.0.0
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Connection (Supabase PostgreSQL or Local PostgreSQL)
# Format: postgres://[user]:[password]@[host]:[port]/[database]?sslmode=disable
# Example Supabase: postgres://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# If left empty, server runs with embedded in-memory persistence suitable for local demo/evaluation.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campus_sensors?sslmode=disable
DATABASE_MAX_CONNS=50
DATABASE_MIN_CONNS=10
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Ingestion Worker Settings
INGESTION_BATCH_MAX_SIZE=5000
INGESTION_WORKERS=8
INGESTION_QUEUE_BUFFER=50000

# Authentication & Security
# Organizer Auth Secret for signing / validating demo session JWTs
ORGANIZER_JWT_SECRET=campus-monitoring-secure-demo-secret-key-32bytes-min
# Organizer Demo Credentials (for local testing / login)
ORGANIZER_ADMIN_EMAIL=organizer@campus.edu
ORGANIZER_ADMIN_PASSWORD=CampusOrganizerSecure2026!
ORGANIZER_VIEWER_EMAIL=viewer@campus.edu
ORGANIZER_VIEWER_PASSWORD=CampusViewerDemo2026!

# Sensor Ingestion Shared Master Key or Per-Sensor API Key Salt
SENSOR_KEY_SALT=campus-sensor-key-salt-2026-gdg

# Sensor Health & Offline Detection
SENSOR_OFFLINE_THRESHOLD=10m
ALERT_WINDOW_EVALUATION_INTERVAL=15s
