meta {
  name: Login Viewer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{viewerEmail}}",
    "password": "{{viewerPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
  res.body.role: eq "viewer"
}
