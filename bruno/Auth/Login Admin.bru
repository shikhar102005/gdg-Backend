meta {
  name: Login Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
  res.body.role: eq "admin"
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("authToken", res.body.token);
  }
}
