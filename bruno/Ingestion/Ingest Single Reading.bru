meta {
  name: Ingest Single Reading
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/readings
  body: json
  auth: none
}

body:json {
  {
    "sensorId": "lib-fl2-temp",
    "type": "temperature",
    "value": 24.2,
    "timestamp": "2026-10-26T04:30:00Z",
    "quality": "good",
    "idempotencyKey": "sensor-read-evt-1001"
  }
}

assert {
  res.status: eq 202
  res.body.status: eq "accepted"
  res.body.reading.value: eq 24.2
}
