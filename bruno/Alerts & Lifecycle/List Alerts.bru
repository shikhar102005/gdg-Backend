meta {
  name: List Alerts
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/alerts?limit=20
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.alerts: isDefined
}

script:post-response {
  if (res.status === 200 && res.body.alerts && res.body.alerts.length > 0) {
    bru.setEnvVar("alertId", res.body.alerts[0].id);
  }
}
